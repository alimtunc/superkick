{
	"name": "web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.0.9",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint -c ../../.oxlintrc.json src/ visual-parity/",
		"fmt": "oxfmt -c ../../.oxfmtrc.json --write src/ visual-parity/",
		"fmt:check": "oxfmt -c ../../.oxfmtrc.json --check src/ visual-parity/",
		"preview": "vite preview",
		"test": "vitest",
		"test:run": "vitest run",
		"visual:parity": "node visual-parity/capture.mjs",
		"visual:parity:list": "node visual-parity/capture.mjs --list",
		"visual:parity:install": "playwright install chromium"
	},
