{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Superkick",
  "version": "0.1.0",
  "identifier": "com.superkick.desktop",
  "build": {
    "frontendDist": "./splash"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Superkick",
        "width": 1280,
        "height": 832,
        "resizable": true
      }
    ]
  }
}
